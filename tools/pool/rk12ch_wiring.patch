+    # ------------------------------------------------------------------
+    def dup_context(self) -> "RknnModel":
+        """复制一个 context(权重共享)。
+
+        ★ rknn_dup_context: 新 context 与原 context 【共享同一份权重】,
+          只有运行时的工作区(输入/输出 tensor 内存)是各自的。
+          12 路各开一个 context 时, 内存从 ~300MB 降到 ~100MB 量级。
+
+        ★ 但本工程【不需要】它: YOLO/LPRNet 各只有一个 worker,
+          12 路的帧在【同一个 context】里组 batch 跑(分核 0_1 / 2),
+          权重天然就是共享的, 每路只额外持有输入输出 buffer。
+          只有"每路一个独立 context + 独立 batch"的方案才需要 dup_context。
+        """
+        if not self.ctx:
+            raise RknnError("context 已销毁")
+        dup = ctypes.c_void_p(0)
+        ret = self.lib.rknn_dup_context(ctypes.byref(self.ctx), ctypes.byref(dup))
+        if ret != 0:
+            raise RknnError(f"rknn_dup_context 失败 ret={ret}")
+        clone = RknnModel.__new__(RknnModel)
+        clone.lib = self.lib
+        clone.ctx = dup
+        clone.info = self.info          # 属性相同
+        clone.core_mask = self.core_mask
+        clone._io_mem = []
+        clone._last_run_us = 0
+        return clone
+
     # ------------------------------------------------------------------
     def close(self) -> None:
         for mem in list(self._io_mem):
