+def alloc_buffer(size: int, prefer_dmabuf: bool = True,
+                fallback_to_cpu: bool = True) -> DmaBuf:
+    """分配一块缓冲。优先 dma-buf, 失败时可退化成 CPU 内存。
+
+    ★ fallback_to_cpu=True 时【一定返回非 None】: 返回 None 会让调用方
+      (比如池的初始化)在 AttributeError 里炸掉, 现场很难看。
+    """
+    if prefer_dmabuf:
+        buf = alloc_dmabuf(size)
+        if buf is not None:
+            return buf
+        if not fallback_to_cpu:
+            raise RuntimeError(f"dma-buf 分配失败({size} 字节)")
+        return alloc_cpu_buffer(size)
+    return alloc_cpu_buffer(size)
 
 
