# ============================================================
# RK3588 边缘 AI 系统 .gitignore
# 目标: 跟踪"源代码 + 文档 + 部署模型"，排除一切大文件与运行产物
# 依据: docs/AGENT_RULES_FOR_CRASH_DEBUGGING.md 第五节（可二分、可回滚的干净基线）
# ============================================================

# ---------- 1. 大文件 / 二进制包 / 模型源文件 ----------
# 板端转换工具链与模型源文件（体积大且可重新生成）
_bench/venv/
_bench/wheel/
_bench/dl/
*.onnx
*.pth
*.pt
*.tar.gz
*.whl
*.zip

# 历史存档（66MB 旧目录备份，可从磁盘直接取，不进版本库）
_archive/

# 测试视频（141MB，磁盘保留供长跑使用，不进版本库）
*.MP4
*.mp4
*.mkv

# 板端转换产物（4.3MB，可由 convert_yolov8n.py 重新生成）
/_bench/*.rknn
# 注意: models/*.rknn 是部署用的单一真源，必须跟踪，不在此列

# 工程内的 model/ 是 models/ 的硬链接镜像（git 不保留硬链接，会存成两份），
# 克隆后用 tools/sync_model_links.sh 重建即可
rk3588_zero_copy/model/

# ---------- 2. 构建产物 ----------
build*/
build_native/
build_stub/
*.o
*.so.tmp
compile_commands.json

# ---------- 3. 运行 / 调试产物 ----------
logs/
*.log
*.jsonl
rk3588_zero_copy/output_rois/
rk3588_zero_copy/output_rois_mp4/
rk3588_zero_copy/output_debug/
rk3588_zero_copy/output_debug_mp4/

# ---------- 4. Python 缓存 ----------
__pycache__/
*.py[cod]
.pytest_cache/
# 虚拟环境(仓库内任何位置创建的 venv 都不入库)
.venv/
venv/
env/

# ---------- 5. 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
*~
*.swp
*~.bak

# ---------- 6. 崩溃现场（临时）----------
core
core.*
vmcore
*.dmp

# 标定图由 DJI MP4 抽取生成（24 帧 × ~590KB），可重新生成，不进版本库
_bench/calib/

# 精度回归采集的图集(体积大, 不入库)
dataset/
dataset_mp4/

# 交付文档的 HTML 中间产物(由 rk3588_zero_copy/scripts/md_to_pdf.sh 生成,
# 随时可以用 md -> html -> pdf 重新生成, 不进版本库)
# 注意: docs/ 下的 .pdf 是要交付的, 必须跟踪, 不在此列
RK3588边缘AI系统交付白皮书.html
.zcode/
__pycache__/

# ---------- 7. 优化沙盒的【产物】(源码入库, 产物不入库) ----------
# 为什么要专门写这一段: 各沙盒(opt_audit / opt_p0 / opt_dfl ...)里的
#   tools/*.cc 与 tests/*.py 是【验证工具】—— 工程的注释里直接引用了它们
#   (如 license_plate_rec.cc 的 "见 opt_audit/tools/fp16_equiv.cc"),
#   工具不入库 = 结论不可复现 = 重演〈O15: base 二进制不可复原〉。
#   所以: 源码入库, 编出来的二进制和采集到的数据不入库。
opt_audit/tools/*[!c]
opt_audit/tools/base_inc
opt_audit/bin/
opt_audit/base/
opt_audit/ab/
opt_audit/ab_c2_c8/
opt_audit/ab_final/
opt_audit/ocr_rois/
opt_p0/out/
opt_p0/tests/acc_batch_ab
opt_p0/tests/acc_batch_ab_before
opt_ebike_fork9/src/acc_batch_nc
opt_ebike_fork9/src/fork9_cpu_bench
opt_ebike_fork9/out/
opt_ebike_fork9/logs/
opt_ebike_fork9/models/
opt_ebike_fork9/onnx/
opt_ebike_fork9/calib/
opt_dfl/out/
opt_dfl/models/
opt_ocr_quant/out/
opt_ocr_quant/models/

# ---------- 8. 沙盒的【重产物】(源码与报告入库, 产物不入库) ----------
# 与第 7 段同一条思路: 各优化沙盒的源码/脚本/报告要入库(可复现),
# 编译产物、模型、采集数据不入库(合计 300MB+)。
audit/__pycache__/
audit/out/
audit/npu_baseline_bench
batch_bench/build/
batch_bench/models/
batch_bench/out/
model_opt/__pycache__/
model_opt/out/
model_opt/models/
model_opt/models_ref/
model_opt/onnx/
npu_layer_bench/build/
npu_layer_bench/models/
prune_finetune/out/
prune_finetune/models/
prune_finetune/onnx/
prune_finetune/data/
audit/npu_baseline_bench
model_opt/model_perf_bench
prune_finetune/model_perf_bench
prune_finetune/models_bench/

# 现场预检探针的编译产物(由 tools/build_field_probe.sh 现场生成, 不入库)
rk3588_zero_copy/tools/field_probe
