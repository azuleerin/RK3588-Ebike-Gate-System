# ============================================================================
# gate.env —— RK3588 小区大门 4 路推理服务的【生产配置】
#
# ★ 这份文件被读两遍, 两边都要兼容:
#     1) systemd: EnvironmentFile=  -> 原样注入环境变量
#     2) scripts/run_gate_service.sh: `source` 之后拼 CLI 参数
#   所以: 【不要写 export】, 不要写命令替换/管道, 值里不要出现未加引号的空格。
#
# ★ 改完之后必须重启服务才生效:
#     sudo systemctl restart rk-gate
#
# ★ 现场部署只需要改本文件 + 重启, 不用碰任何 .service / .sh。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 二进制与库路径
# ---------------------------------------------------------------------------
GATE_PROJ=/home/seeed/rk_deploy/rk3588_zero_copy
GATE_BIN=/home/seeed/rk_deploy/rk3588_zero_copy/build/rk_gate
# ★ librga.so 只在 third_party/lib 里; librockchip_mpp.so 只在
#   /usr/lib/aarch64-linux-gnu 里(CMakeLists.txt:130,139 钉死了这个路径, 不能换)
GATE_LD_LIBRARY_PATH=/home/seeed/rk_deploy/rk3588_zero_copy/third_party/lib:/home/seeed/rk_deploy/rk3588_zero_copy/lib:/usr/lib

# ---------------------------------------------------------------------------
# 2. 模型 (models/ 是只读真源, 这里只【引用】不拷贝)
# ---------------------------------------------------------------------------
# ★ ebike_int8_rk2332.rknn 必须用这一个: 算法组的 ebike_int8.rknn 是
#   toolkit 2.5.0 编的, 板端 runtime 是 2.3.2, 加载会失败(坑位 01)。
GATE_MODEL=/home/seeed/rk_deploy/models/ebike_int8_rk2332.rknn
GATE_LABELS=/home/seeed/rk_deploy/models/labels_ebike.txt
GATE_OCR=/home/seeed/rk_deploy/models/ppocrv4_rec_fp16.rknn
GATE_OCR_DICT=/home/seeed/rk_deploy/models/ppocr_keys_v1.txt

# ---------------------------------------------------------------------------
# 3. 4 路视频源
# ---------------------------------------------------------------------------
# ★ 默认填仓库现有素材 —— 开箱即跑, 可以立刻端到端验证整套守护链路。
#   素材规格见 scripts/run_4ch_gate_single.sh:
#     ch1 720p30  近景(有绿牌)   ch2 720p21.5 街道(测速)
#     ch3 1080p60 近景(有绿牌)   ch4 4K60   高位全景(测速)
#
# ★ 现场换相机: 只改下面 8 行的【值】, 不用改任何脚本。形如:
#     GATE_CH1=rtsp://192.168.31.200:8557/h264
#     GATE_CH1_KIND=near
#     GATE_CH2=rtsp://192.168.31.201:8554/main
#     GATE_CH2_KIND=high
#     GATE_CH2_IPM="300,622;1500,643;1450,877;550,819"
#
#   KIND: near=近景(车牌 ROI) / high=高位(测速, 需要 IPM 标定点)
#   IPM : 原图像素坐标的 4 个点, 分号分隔, 格式 "x1,y1;x2,y2;x3,y3;x4,y4"
#         相机换了分辨率就必须重标(见 docs/现场环境适配指南.md)
GATE_CH1=/home/seeed/testvideo3.mp4
GATE_CH1_KIND=near
GATE_CH2=/home/seeed/testvideo2.mp4
GATE_CH2_KIND=high
GATE_CH2_IPM="200,415;1000,429;967,585;367,546"
GATE_CH3=/home/seeed/Test2_fixed.mp4
GATE_CH3_KIND=near
GATE_CH4=/home/seeed/电动车素材.mp4
GATE_CH4_KIND=high
GATE_CH4_IPM="600,1244;3000,1286;2900,1754;1100,1638"

# ---------------------------------------------------------------------------
# 4. NPU 核绑定 (与 scripts/run_4ch_gate_single.sh 同口径)
# ---------------------------------------------------------------------------
#   ★ 三核全开: 检测(YOLO) -> Core0+1+2 ; 识别(PP-OCR) -> Core0+1+2
#     (每核 1 检测 worker + 1 识别 worker, i%3 轮询)
#
#   ★ 2026-11-19 封板 A/B 实测(同一块板, 4 路, 停掉 rk-minimal 之后):
#       配置                      4 路合计    detwait      CPU
#       检测 1,2 + 识别 0        68.30 FPS   46~56 ms   (检测核打满, 排队)
#       检测 0,1,2 + 识别 0,1,2  78.40 FPS   33~38 ms   21.9%
#     差距 10 FPS 全在【检测核排队】上 —— 三核全开把 detwait 拉回基线水平。
#     NPU 三核 69/68/66 极差 3, 与纯净基线(65/66/65)一致。
#     ★ 历史文档里"三核全开会让 CPU 飙到 78%、反而更慢"是【旧版本】的结论
#       (当时 3 个检测 worker 同时做 DFL+NMS 把 CPU 吃掉了), 现版本已不成立。
#       以本文件里的实测为准, 别照旧结论改回去。
#   掩码 1/2/4 = Core0/1/2; 单个核的掩码不能填 7(0x7 三核合一已被驱动层禁用)。
GATE_DET_CORES=0,1,2
GATE_OCR_CORES=0,1,2
GATE_DET_WORKERS=3
GATE_OCR_WORKERS=3

# ---------------------------------------------------------------------------
# 5. 推理参数 (与 A/B 基线同参, 保证实测可比)
# ---------------------------------------------------------------------------
GATE_CONF=0.15
GATE_NMS=0.45
GATE_MAX_FPS=20
GATE_STATS_INTERVAL=100
GATE_DET_SLOTS=2

# ---------------------------------------------------------------------------
# 6. 近景车牌 ROI 几何 (与 run_4ch_gate_single.sh 同值)
# ---------------------------------------------------------------------------
GATE_ROI_RATIO=0.164
GATE_ROI_Y=1.0
GATE_ROI_HEIGHT=0.40
GATE_ROI_SHIFT=0.126
GATE_ROI_BELOW=0
GATE_IPM_WIDTH_M=3.5

# ---------------------------------------------------------------------------
# 7. 上报
# ---------------------------------------------------------------------------
GATE_SN=RK3588-GATE-01
GATE_DEVICE_NAME=0001
GATE_IPADDR=192.168.31.77
# ★ MQTT broker: 留空 = 不发 MQTT(只本地计数)。
#   现场填了 broker, 看门狗的 MQTT 探针才会生效(见 gate_watchdog.sh)。
GATE_MQTT_HOST=
GATE_MQTT_PORT=1883
GATE_MQTT_QOS=1

# ---------------------------------------------------------------------------
# 8. 过线计数 (二期 KPI; 留空 = 不启用)
# ---------------------------------------------------------------------------
# 格式 "x1,y1,x2,y2"(原图像素)。只有分辨率相同的相机才能共用一条线,
# 不同分辨率必须按相机分别配 —— 所以这里按通道配。
GATE_TRIPWIRE_CH1=
GATE_TRIPWIRE_CH2=
GATE_TRIPWIRE_CH3=
GATE_TRIPWIRE_CH4=
GATE_TRIPWIRE_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# 9. 运行控制
# ---------------------------------------------------------------------------
# ★ 互斥锁文件路径。改这个 = 改"双实例互斥"用的锁。
#   标准值 /run/rk-gate/rk-gate.lock (子目录), 不要改回 /run 根上:
#     /run 是 tmpfs, 每次重启清空; /run 本身 root:root 755, 服务以 seeed 跑,
#     在 /run 根上建不了文件 -> 2026-11-21 服务就是死在这条上(exit 75)。
#   /run/rk-gate/ 由 unit 的 RuntimeDirectory=rk-gate 建, owner=seeed:seeed。
#   ★ 要换路径时, 新目录必须对 seeed 可写, 否则同样起不来。
#   ⚠ 临时值(等 unit 装上 RuntimeDirectory 后改回 /run/rk-gate/rk-gate.lock):
GATE_LOCK_FILE=/run/rk-gate/rk-gate.lock
# ★ duration=0 = 一直跑(生产就该是这个值; 压测时才设成 600 之类)
GATE_DURATION=0
# ★ 日志目录: 落在【真实磁盘】上, 不是 zram。
#   ★★ 为什么必须换(2026-11-23 实测):
#      本板 /var/log 是 47MB 的 zram 内存盘(而且 /var/log/syslog + kern.log
#      还在自己长) —— 业务日志写满会触发 write() ENOSPC, 应用直接崩(R19)。
#      还有一条更隐蔽的坑: zram 占的是【真 RAM】, 写进去的每一页都算内存。
#   ★ /var/log.hdd 是 overlayroot 上的真实目录(105GB, 实测剩 78GB)。
#   ★ 改这个值之后【必须】重跑 install_gate_service.sh:
#      它会把 unit 里的 StandardOutput/StandardError 路径、
#      rk-collect-crash 的取证路径、以及 /etc/logrotate.d/rk-gate 规则
#      里的路径【一起】改掉 —— 只改这一行不管用, unit 还会往 /var/log 写。
#   ★ 看门狗 / 预检 / 体检脚本都是自己 source 本文件的, 所以它们会自动跟上。
GATE_LOG_DIR=/var/log.hdd
# ★ 服务运行用户(安装脚本据此给日志文件赋权)
GATE_SERVICE_USER=seeed

# ---------------------------------------------------------------------------
# 10. 应用日志级别 (映射到环境变量 RK_LOG_LEVEL)
# ---------------------------------------------------------------------------
# ★★ 必须是 warn —— 这是本板实测出来的硬约束:
#     帧守卫对【每一帧】都打构造/析构 INFO, 4 路并发实测日志速率
#     36.5 MB/小时 ≈ 17 GB/天, 而 /var/log 只有 47MB 的 zram ——
#     不到 1 小时就写满, 写满后 write() 返回 ENOSPC, 应用会崩。
#     设成 warn 后逐帧日志关闭(守卫的计数器照常维护), 日志速率降到 1/300。
#     ★ 注意: 【业务统计行不受影响】—— 它是直接 fprintf(stderr), 不走分级日志,
#       所以看门狗的 L1 日志心跳 / L2 单路帧号心跳照常工作。
#     ★ 排障时临时改成 info: sudo systemctl edit rk-gate  或直接改这个值后重启。
GATE_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# 11. 看门狗水位告警线 (只告警, 不重启)
#
# ★★★ 2026-11-23 按【修完活堆泄漏 + 页缓存治理后】的实测稳态重新校准。
#   旧值(400/200/8)是"泄漏还在、页缓存把 cgroup 顶满"那个状态下定的 ——
#   那时稳态是 RSS 631MB / 活堆 489MB, 照抄到新稳态上要么天天误报, 要么没意义。
#
#   实测稳态(4 路 + max_fps=20 + 4 个 1080p 视频源; 2026-11-23 长跑 46.7 分钟
#   / 56,400 帧每路, 278 次 cgroup 采样, 零重启零告警):
#       RSS   228.6~231.7 MB   活堆   73.3~74.2 MB
#       cgroup 合计 190.4~243.4 MB (均值 209.7)
#         anon 81.5~84.2 / file 106.3~157.2 / shmem 98.1 / kernel 3.1~3.3  (MB)
#
#   取值原则 = 实测稳态 x 1.5~2 倍:
#     RSS_WARN_MB=350   (1.5x) RSS 含 98MB 的 dma-buf, 瞬时波动比活堆大, 余量给宽点
#     HEAP_WARN_MB=150  (2.0x) 活堆是最灵敏的泄漏指标, 宁可早报
#                         (旧泄漏速率 1.4MB/min -> 越线后约 55 分钟才撞 MemoryMax)
#     CGROUP_WARN_MB=400      cgroup 总量告警线, 是新配 MemoryMax=512M 的 ~78%
#                         (实测峰值 243.4MB = 上限的 47.5%)
#                         ★ 这条是 2026-11-23 新增的: 之前只有 RSS/活堆两个指标,
#                           而 cgroup 顶满 1G 的主因【既不是 RSS 也不是活堆】,
#                           是没人看的 file(页缓存)分量 —— 没有这条就发现不了。
#     LOG_FREE_WARN_MB=2048   日志盘已从 47MB zram 换成 105GB 真实盘;
#                         旧值 8MB 是按 zram 定的, 照抄等于永远不报警
#
#   ★ 这些值看门狗自己 source 本文件读取, 改完重启看门狗即可生效:
#       sudo systemctl restart rk-gate-watchdog
# ---------------------------------------------------------------------------
RSS_WARN_MB=350
HEAP_WARN_MB=150
CGROUP_WARN_MB=400
LOG_FREE_WARN_MB=2048
