[Unit]
Description=RK3588 大门 真实相机本地 1 拉 4 播零转码中继 (Phase 1)
Documentation=file:///home/seeed/rk_deploy/docs/p2b_rtsp_4ch_verify_report.md
After=network-online.target
Wants=network-online.target

# ★ 必须在 rk-gate 之前起: rk_gate 的 4 路通道连的是本中继
#   (rtsp://127.0.0.1:8555/live), 中继没起来, 4 路通道开不了源。
# ★ 用 Before 而不是让 rk-gate 写 Requires=:
#   Requires 的话, 中继崩了会把 rk-gate 一起停掉, 而 rk-gate 是
#   Restart=on-failure —— "被依赖停掉"不算失败, 不会自己起来,
#   结果就是中继回来了、业务却还躺着。
#   现在改成: rk-gate 侧只写 Wants= + After= (见 10-fanout.conf),
#   中继(重)启动后由下面的 ExecStartPost 顺手把业务重启一次。
Before=rk-gate.service

# 启动频率限制: 5 分钟内失败 10 次 -> 停在 failed 不再重试
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=seeed
Group=seeed
WorkingDirectory=/home/seeed/rk_deploy/rk3588_zero_copy

# ★ 相机地址从【仓库外】的私密文件读, 所以命令行里没有账号密码,
#   ps / /proc/<pid>/cmdline 都看不到凭据。
ExecStart=/usr/bin/python3 /home/seeed/rk_deploy/rk3588_zero_copy/scripts/rtsp_fanout_server.py --bind 127.0.0.1 --port 8555 --path /live --source-file /home/seeed/.config/rk-gate/real_rtsp.url

# ★ 中继崩了必须自己回来: 它挂了 = 4 路真实流全断。
#   RestartSec=3 秒, 配合下面的 ExecStartPost 一起把业务带回来。
Restart=always
RestartSec=3

# ★★ 不要在这里 ExecStartPost 去 restart rk-gate ★★
#   rk-gate 侧带 After=rk-gate-fanout.service(见 10-fanout.conf), 而
#   ExecStartPost 属于本 unit 的【启动作业】—— 启动作业没结束, rk-gate 的
#   启动作业就不能开始, 于是"在 ExecStartPost 里重启 rk-gate"直接构成
#   排序死锁, systemd 会拒绝该作业(实测: rk-gate 根本没被重启, 也没报错)。
#
#   中继崩溃后的业务恢复交给【已有的看门狗】: rk_gate 的 4 路通道断流后
#   帧号停推进, 看门狗的 L1/L2 会在 60~180 秒内判定并重启 rk-gate,
#   重启后 4 路自然重新连上中继。不必在这里再加一条耦合。

# 日志落文件(本板 journald 是 Storage=volatile, 重启即丢)
StandardOutput=append:/var/log.hdd/rk-gate-fanout.log
StandardError=append:/var/log.hdd/rk-gate-fanout.log
SyslogIdentifier=rk-gate-fanout

# 不产生 core 文件
LimitCORE=0

# cgroup 内存上限: 中继只做 RTP 转发(不解码), 稳态约 20~30 MB。
#   队列上限 900 包/客户端 x 4 客户端 ≈ 5 MB, 256M 已经很宽松。
#   设上限是为了万一哪天改成了解码/转码, 不会把整机拖垮。
MemoryHigh=128M
MemoryMax=256M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
